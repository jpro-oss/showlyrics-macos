{
  "name": "showlyrics",
  "version": "2.5.0",
  "main": "src/main.js",
  "description": "Lyrics Presentation System",
  "author": "JProduction",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:x64": "electron-builder --mac --x64",
    "dist:dmg": "electron-builder --mac dmg",
    "dist:zip": "electron-builder --mac zip"
  },
  "build": {
    "appId": "com.showlyrics.engine",
    "productName": "ShowLyricsApp",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ],
      "icon": "src/app.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "ShowLyricsApp ${version}",
      "icon": "src/app.icns",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "electron-wrapper": "^1.7.2"
  }
}
